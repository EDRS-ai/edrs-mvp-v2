{
  "name": "edrs-mvp-v2",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "build:js": "esbuild src/client.tsx --bundle --minify --format=esm --outfile=public/client.js",
    "build:css": "tailwindcss -c tailwind.config.js -i src/styles.css -o public/styles.css --minify",
    "build:vendor": "node scripts/copy-vendor.mjs",
    "build": "npm run build:js && npm run build:css && npm run build:vendor",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && npm run test && wrangler deploy"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "better-sqlite3": "^11.3.0",
    "esbuild": "^0.28.2",
    "leaflet": "^1.9.4",
    "tailwindcss": "^3.4.19",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  }
}
